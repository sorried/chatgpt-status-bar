if(CMAKE_HOST_APPLE)
    set(app "${ROOT}/gpt-status-bar.app/Contents/MacOS/gpt-status-bar")
elseif(CMAKE_HOST_WIN32)
    set(app "${ROOT}/bin/gpt-status-bar.exe")
    set(ENV{PATH} "$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
else()
    set(app "${ROOT}/bin/gpt-status-bar")
endif()
if(NOT EXISTS "${app}")
    message(FATAL_ERROR "Installed application not found: ${app}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=QT_PLUGIN_PATH --unset=QML2_IMPORT_PATH --unset=LD_LIBRARY_PATH --unset=DYLD_LIBRARY_PATH QT_QPA_PLATFORM=offscreen "${app}" --preview --smoke-test RESULT_VARIABLE result TIMEOUT 20)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Installed application startup failed: ${result}")
endif()
